# Only needed for native TV builds (Fire TV / Android TV / Apple TV), which
# can't use a relative URL. Web and the Vega WebView leave this unset.
# EXPO_PUBLIC_API_URL=https://spooky-story-maker.vercel.app

# Server-side, for `vercel dev` (never EXPO_PUBLIC_, which would ship it in the
# app). `vercel env pull` fills these in from the Vercel project.
# ELEVENLABS_API_KEY=
# BLOB_READ_WRITE_TOKEN=
