{
  "name": "spooky-story-maker-app",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "dev": "npx vercel dev --listen 127.0.0.1:3000",
    "deploy": "npx vercel deploy --prod"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@expo-google-fonts/creepster": "^0.4.0",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.4",
    "expo": "~57.0.13",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react-native": "npm:react-native-tvos@0.86-stable"
  }
}
